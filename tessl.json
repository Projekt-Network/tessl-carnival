{
  "name": "projekt-network/tessl-carnival",
  "mode": "vendored",
  "dependencies": {},
  "schedules": {
    "doc-gardening": {
      "cron": "0 6 * * 1",
      "description": "Find docs and agent instructions that no longer match the code, and file an issue for each",
      "action": {
        "skill": "file:tessl-factory#doc-gardening",
        "environment": "tessl-carnival-loops",
        "agent": "claude",
        "model": "claude-sonnet-5-5"
      }
    },
    "test-health": {
      "cron": "0 6 * * 1",
      "description": "Find tests that can't fail or don't check what they claim, and file an issue for each",
      "action": {
        "skill": "file:tessl-factory#test-health",
        "environment": "tessl-carnival-loops",
        "agent": "claude",
        "model": "claude-sonnet-5-5"
      }
    }
  }
}
